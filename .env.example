# Mini Vercel configuration. Every value below has a working local default,
# so a .env file is only needed to change something. All services read the
# same variables and ignore the ones they don't use.

# --- Data stores (local docker compose ports) ---
MV_DATABASE_URL=postgres://minivercel:minivercel@localhost:5433/minivercel?sslmode=disable
MV_REDIS_ADDR=localhost:6380
MV_REDIS_PASSWORD=

# --- Object storage: SeaweedFS locally, Cloudflare R2 in production ---
MV_S3_ENDPOINT=http://localhost:9000
MV_S3_REGION=us-east-1
MV_S3_ACCESS_KEY=minivercel
MV_S3_SECRET_KEY=minivercel-secret
MV_S3_BUCKET=deployments
# R2 example:
# MV_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MV_S3_REGION=auto

# --- Secrets: 32 bytes, hex or base64. CHANGE THIS in production. ---
# Generate: openssl rand -hex 32
MV_ENCRYPTION_KEY=6d696e692d76657263656c2d6465762d6b65792d33322d62797465732d212121

# --- Public routing: sites are served at <label>.<root>[:port] ---
MV_ROOT_DOMAIN=localhost
MV_PUBLIC_SCHEME=http
MV_PUBLIC_PORT=8080

# --- Service addresses ---
MV_API_ADDR=:4000
MV_EDGE_ADDR=:8080
MV_DASHBOARD_DIR=           # e.g. dashboard/out to serve the dashboard from the API
MV_CORS_ORIGINS=http://localhost:3000
MV_API_TOKEN=               # set to require "Authorization: Bearer <token>"

# --- Build sandbox limits ---
MV_BUILD_IMAGE=node:22-alpine   # .nvmrc / engines.node switch to Node 18/20/22/24 automatically
MV_BUILD_CPUS=1
MV_BUILD_MEMORY_MB=2048
MV_BUILD_PIDS=256
MV_BUILD_TIMEOUT_SEC=600
MV_WORKER_CONCURRENCY=2

# --- Free public URLs (Cloudflare quick tunnels, no account needed) ---
MV_TUNNEL_IMAGE=cloudflare/cloudflared:2025.10.0
MV_TUNNEL_ORIGIN=http://host.docker.internal:8080   # how the tunnel container reaches the edge router
